{
  "name": "texpresso-basic",
  "displayName": "TeXpresso",
  "description": "Basic extension for interacting with TeXpresso for live previewing LaTeX documents",
  "publisher": "DominikPeters",
  "version": "1.9.0",
  "icon": "./assets/texpresso_logo.png",
  "homepage": "https://github.com/DominikPeters/texpresso-vscode",
  "repository": {
    "type": "git",
    "url": "https://github.com/DominikPeters/texpresso-vscode.git"
  },
  "engines": {
    "vscode": "^1.88.0"
  },
  "categories": [
    "Education",
    "Other"
  ],
  "keywords": [
    "texpresso",
    "latex",
    "tex",
    "preview",
    "syncTeX"
  ],
  "activationEvents": [
    "onLanguage:latex",
    "onLanguage:tex"
  ],
  "main": "./dist/extension.js",
  "license": "MIT",
  "contributes": {
    "commands": [
      {
        "command": "texpresso.startDocument",
        "title": "TeXpresso: Start Document",
        "enablement": "!texpresso.starting",
        "icon": "$(play)"
      },
      {
        "command": "texpresso.selectMainDocument",
        "title": "TeXpresso: Select Main Document"
      },
      {
        "command": "texpresso.refresh",
        "title": "TeXpresso: Refresh (Restart Preview)",
        "enablement": "texpresso.running"
      },
      {
        "command": "texpresso.externalCompileAndRefresh",
        "title": "TeXpresso: External Compile and Refresh",
        "enablement": "texpresso.running"
      },
      {
        "command": "texpresso.previousPage",
        "title": "TeXpresso: Show Previous Page in Preview",
        "icon": "$(arrow-circle-left)",
        "enablement": "texpresso.inActiveEditor"
      },
      {
        "command": "texpresso.nextPage",
        "title": "TeXpresso: Show Next Page in Preview",
        "icon": "$(arrow-circle-right)",
        "enablement": "texpresso.inActiveEditor"
      },
      {
        "command": "texpresso.syncTeXForward",
        "title": "TeXpresso: Show Current Position in Preview Window (SyncTeX)",
        "shortTitle": "TeXpresso SyncTeX",
        "enablement": "texpresso.inActiveEditor"
      },
      {
        "command": "texpresso.syncTeXForwardShortName",
        "title": "TeXpresso SyncTeX",
        "enablement": "texpresso.inActiveEditor"
      },
      {
        "command": "texpresso.activateSyncTeXForward",
        "title": "TeXpresso: Activate SyncTeX Forward",
        "enablement": "texpresso.inActiveEditor && !config.texpresso.syncTeXForwardOnSelection",
        "icon": "$(sync-ignored)"
      },
      {
        "command": "texpresso.deactivateSyncTeXForward",
        "title": "TeXpresso: Deactivate SyncTeX Forward",
        "enablement": "texpresso.inActiveEditor && config.texpresso.syncTeXForwardOnSelection",
        "icon": "$(sync)"
      },
      {
        "command": "texpresso.adoptTheme",
        "title": "TeXpresso: Adopt Editor Color Theme",
        "enablement": "texpresso.running"
      },
      {
        "command": "texpresso.defaultTheme",
        "title": "TeXpresso: Adopt Default Color Theme",
        "enablement": "texpresso.running"
      },
      {
        "command": "texpresso.stop",
        "title": "TeXpresso: Stop",
        "enablement": "texpresso.active",
        "icon": "$(debug-stop)"
      },
      {
        "command": "texpresso.restart",
        "title": "TeXpresso: Restart Preview",
        "icon": "$(refresh)",
        "enablement": "texpresso.hasDocument && !texpresso.starting"
      },
      {
        "command": "texpresso.showControls",
        "title": "TeXpresso: Preview Controls"
      },
      {
        "command": "texpresso.checkSetup",
        "title": "TeXpresso: Check Setup"
      },
      {
        "command": "texpresso.showEngineLog",
        "title": "TeXpresso: Show Engine Log"
      },
      {
        "command": "texpresso.showCompilerOutput",
        "title": "TeXpresso: Show Compiler Output"
      },
      {
        "command": "texpresso.openSettings",
        "title": "TeXpresso: Open Settings"
      },
      {
        "command": "texpresso.rerunOnce",
        "title": "TeXpresso: Rerun Once",
        "icon": "$(run-all)",
        "enablement": "texpresso.canRerun"
      },
      {
        "command": "texpresso.pause",
        "title": "TeXpresso: Pause Preview",
        "icon": "$(debug-pause)",
        "enablement": "texpresso.canPause && !texpresso.paused"
      },
      {
        "command": "texpresso.resume",
        "title": "TeXpresso: Resume Preview",
        "icon": "$(play)",
        "enablement": "texpresso.canPause && texpresso.paused"
      },
      {
        "command": "texpresso.enableAutoRerun",
        "title": "TeXpresso: Enable Automatic Reruns",
        "enablement": "texpresso.canAutoRerun && !texpresso.autoRerun"
      },
      {
        "command": "texpresso.disableAutoRerun",
        "title": "TeXpresso: Disable Automatic Reruns",
        "enablement": "texpresso.canAutoRerun && texpresso.autoRerun"
      }
    ],
    "configuration": {
      "title": "TeXpresso",
      "properties": {
        "texpresso.command": {
          "type": "string",
          "default": "texpresso",
          "description": "Path to the texpresso binary",
          "scope": "machine-overridable",
          "order": 1
        },
        "texpresso.externalCompileCommand": {
          "type": "string",
          "default": "latexmk",
          "description": "External command for multi-pass compilation of LaTeX documents",
          "scope": "resource"
        },
        "texpresso.useWSL": {
          "type": "boolean",
          "default": false,
          "description": "Specifies whether texpresso should be run in WSL (Windows Subsystem for Linux)",
          "scope": "machine-overridable"
        },
        "texpresso.syncTeXForwardOnSelection": {
          "type": "boolean",
          "default": true,
          "description": "Specifies whether the preview should be updated when the selection in the editor changes (SyncTeX forward)",
          "scope": "resource"
        },
        "texpresso.useEditorTheme": {
          "type": "boolean",
          "default": false,
          "description": "Specifies whether the preview should use the same color theme as the editor (if activated), or the default theme (otherwise)",
          "scope": "resource"
        },
        "texpresso.useChangeRangeMode": {
          "type": "boolean",
          "default": false,
          "description": "Use the newer change-range command (line/character based) instead of change command (byte based). Requires TeXpresso version v0.1 or newer with change-range support. Recommended if available",
          "scope": "resource"
        },
        "texpresso.arguments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "markdownDescription": "Additional arguments passed to TeXpresso, one array item per argument. Prefer the package provider and include directory settings for those options. The package provider setting takes precedence when explicitly selected. Takes effect when starting a document.",
          "order": 20
        },
        "texpresso.packageProvider": {
          "type": "string",
          "enum": [
            "auto",
            "texlive",
            "tectonic"
          ],
          "enumItemLabels": [
            "Automatic",
            "TeX Live",
            "Tectonic"
          ],
          "enumDescriptions": [
            "Let TeXpresso choose an installed package provider.",
            "Load packages from TeX Live.",
            "Load packages from Tectonic."
          ],
          "default": "auto",
          "scope": "resource",
          "order": 2,
          "markdownDescription": "Where TeXpresso loads LaTeX packages. Requires TeXpresso v0.2 or newer. An explicit selection overrides provider flags in `texpresso.arguments`. Takes effect when starting a document."
        },
        "texpresso.includeDirectories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "order": 3,
          "markdownDescription": "Additional directories to search for project files, relative to the main document or absolute. In WSL mode, Linux paths and Windows paths are accepted. Takes effect when starting a document."
        },
        "texpresso.autoRerun": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "order": 4,
          "markdownDescription": "Automatically run additional passes to update references and the table of contents after editing pauses. Requires TeXpresso with the merged `rerun` protocol support (July 2026 or newer). Takes effect immediately."
        },
        "texpresso.watchDependencies": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "order": 5,
          "markdownDescription": "Refresh the preview when project dependencies change on disk. Uses file-lookup notifications on newer TeXpresso builds to track images and other resources, and source-file notifications on older builds."
        },
        "texpresso.streamFiles": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "order": 21,
          "markdownDescription": "Start TeXpresso in streaming mode and supply project files, including binary resources, through the editor protocol. Requires the merged `-stream`, `register`, `resume`, and `open-base64` support (May 2026 or newer). Takes effect when starting a document."
        },
        "texpresso.previewLocation": {
          "type": "string",
          "enum": [
            "auto",
            "editor",
            "window"
          ],
          "default": "auto",
          "enumDescriptions": [
            "Use the editor preview when the installed engine supports it; otherwise open its window.",
            "Show the preview in an editor tab. Requires a TeXpresso build with headless preview support.",
            "Open the native TeXpresso preview window."
          ],
          "description": "Where to display the TeXpresso preview. Restart the preview after changing this setting.",
          "scope": "resource"
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "when": "texpresso.inActiveEditor",
          "command": "texpresso.previousPage",
          "group": "navigation@1"
        },
        {
          "when": "texpresso.inActiveEditor",
          "command": "texpresso.nextPage",
          "group": "navigation@2"
        },
        {
          "when": "texpresso.inActiveEditor && !config.texpresso.syncTeXForwardOnSelection",
          "command": "texpresso.activateSyncTeXForward",
          "group": "navigation@1"
        },
        {
          "when": "texpresso.inActiveEditor && config.texpresso.syncTeXForwardOnSelection",
          "command": "texpresso.deactivateSyncTeXForward",
          "group": "navigation@1"
        },
        {
          "when": "editorLangId =~ /^(latex|tex)$/ && !texpresso.active",
          "command": "texpresso.startDocument",
          "group": "navigation@0"
        },
        {
          "when": "texpresso.inActiveEditor || texpresso.starting",
          "command": "texpresso.stop",
          "group": "navigation@3"
        }
      ],
      "editor/context": [
        {
          "when": "texpresso.inActiveEditor",
          "command": "texpresso.syncTeXForwardShortName",
          "group": "2_preview"
        }
      ],
      "commandPalette": [
        {
          "command": "texpresso.syncTeXForwardShortName",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node scripts/test-node.cjs",
    "test:unit": "npm run compile-tests && node scripts/test-node.cjs",
    "test:integration": "npm run compile-tests && npm run compile && node scripts/test-integration.cjs",
    "test:integration:engine": "npm run compile-tests && npm run compile && node scripts/test-integration.cjs --real-engine",
    "test:engine": "npm run compile-tests && node scripts/test-node.cjs engine",
    "package:vsix": "node scripts/package.cjs",
    "test:package": "npm run compile-tests && npm run package:vsix && node scripts/check-vsix.cjs artifacts/texpresso.vsix && node scripts/test-integration.cjs --packaged",
    "test:integration:preview": "npm run compile-tests && npm run compile && node scripts/test-integration.cjs --preview"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "18.x",
    "@types/tmp": "^0.2.6",
    "@types/vscode": "^1.88.0",
    "@typescript-eslint/eslint-plugin": "^7.7.1",
    "@typescript-eslint/parser": "^7.7.1",
    "@vscode/test-cli": "^0.0.8",
    "@vscode/test-electron": "^2.3.9",
    "eslint": "^8.57.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.4.5",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "tmp": "^0.2.3",
    "wsl-path": "^4.0.0"
  }
}
